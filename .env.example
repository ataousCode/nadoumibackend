# Nadoumi Backend — Railway Production Environment Template

# Server Configuration
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://nadoumi.com

# Database (Railway Managed)
# Railway provides this automatically when the PostgreSQL service is added.
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Cache & Queues (Railway Managed)
# Railway provides this automatically when the Redis service is added.
REDIS_URL=rediss://default:pass@host:port

# Security
# Generate a strong 32+ character string.
JWT_SECRET=your-32-character-secure-jwt-secret-here

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=Nadoumi <noreply@nadoumi.com>

# Logging (Optional)
LOG_LEVEL=info
