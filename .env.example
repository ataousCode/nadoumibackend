# ─── Server ──────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── Database (PostgreSQL via Prisma) ────────────────
# Use Internal URL when hosted on Render (same region, no egress cost)
DATABASE_URL=postgresql://nadoumi_db_user:PASSWORD@dpg-xxxx-a/nadoumi_db

# ─── JWT ─────────────────────────────────────────────
# REQUIRED in production — server will refuse to start without this
JWT_SECRET=generate-a-long-random-secret-here
JWT_EXPIRES_IN=7d

# ─── Frontend ─────────────────────────────────────────
FRONTEND_URL=https://nadoumi.com

# ─── Redis (Upstash — use rediss:// for TLS) ─────────
REDIS_URL=rediss://default:PASSWORD@quality-ewe-57999.upstash.io:6379

# ─── Email (Gmail App Password) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=almouslecka@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=Nadoumi <almouslecka@gmail.com>
ADMIN_EMAIL=almouslecka@gmail.com

# ─── Local Development only ───────────────────────────
# NODE_ENV=development
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nadoumi
# REDIS_URL=redis://localhost:6381
# MAILDEV_HOST=localhost
# MAILDEV_PORT=1025
