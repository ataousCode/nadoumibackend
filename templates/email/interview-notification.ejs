<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interview Scheduled - Nadoumi</title>
  <style><%- include('../styles/email-base.css') %></style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">Nadoumi</div>
      <h1>Interview Scheduled 📅</h1>
    </div>
    
    <div class="info-banner">
      <p style="margin: 0; font-size: 18px; font-weight: 600;" class="text-purple">
        Congratulations, <%= firstName %>!
      </p>
      <p style="margin: 10px 0 0 0; font-size: 14px;" class="text-purple-light">
        Your application has been selected for an interview
      </p>
    </div>
    
    <p>We are pleased to inform you that your scholarship application <strong>(<%= applicationId %>)</strong> for <strong><%= scholarshipTitle %></strong> has been selected for an interview.</p>
    
    <div class="info-box">
      <h2>Interview Details</h2>
      
      <% if (interviewDate) { %>
      <div class="detail-row">
        <span class="detail-label">📅 Date:</span>
        <span class="detail-value"><%= new Date(interviewDate).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
      </div>
      <% } %>
      
      <% if (interviewTime) { %>
      <div class="detail-row">
        <span class="detail-label">🕐 Time:</span>
        <span class="detail-value"><%= interviewTime %> (China Beijing Time)</span>
      </div>
      <% } %>
      
      <div class="warning-note">
        <strong>⏰ Timezone:</strong> All times are in China Beijing Time (UTC+8). Please convert to your local time zone.
      </div>
      
      <% if (videoCallPlatform) { %>
      <div class="detail-row">
        <span class="detail-label">💻 Platform:</span>
        <span class="detail-value"><%= videoCallPlatform %></span>
      </div>
      <% } %>
      
      <% if (videoCallLink) { %>
      <div class="detail-row">
        <span class="detail-label">🔗 Meeting Link:</span>
        <span class="detail-value">
          <a href="<%= videoCallLink %>" style="color: #f97316; text-decoration: none; word-break: break-all;" target="_blank">
            Join Meeting
          </a>
        </span>
      </div>
      <% } %>
    </div>
    
    <% if (notes || adminNote) { %>
    <div class="note-box">
      <h3>Additional Information:</h3>
      <% if (adminNote) { %>
      <p style="margin: 8px 0;"><strong>Admin Note:</strong> <%= adminNote %></p>
      <% } %>
      <% if (notes) { %>
      <p style="margin: 8px 0;"><%= notes %></p>
      <% } %>
    </div>
    <% } %>
    
    <div class="next-steps-box">
      <h3 class="text-warning">📋 What to Prepare:</h3>
      <ul class="text-warning-light">
        <li>Review your application and scholarship details</li>
        <li>Prepare questions about the program</li>
        <li>Test your video call setup in advance</li>
        <li>Ensure a quiet, well-lit environment</li>
        <li>Have your documents ready if needed</li>
      </ul>
    </div>
    
    <div class="button-container">
      <a href="<%= frontendUrl || 'http://localhost:5173' %>/student/profile" class="button">
        View Application Details
      </a>
    </div>
    
    <p>If you have any questions or need to reschedule, please contact us as soon as possible. We look forward to speaking with you!</p>
    
    <div class="footer">
      <p>Good luck with your interview!</p>
      <p>&copy; <%= new Date().getFullYear() %> Nadoumi. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
