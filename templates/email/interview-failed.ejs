<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Application Update - Nadoumi</title>
  <style><%- include('../styles/email-base.css') %></style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">Nadoumi</div>
      <h1>Application Update</h1>
    </div>
    
    <div class="error-banner">
      <p style="margin: 0; font-size: 18px; font-weight: 600;" class="text-error">
        Application Status Update
      </p>
    </div>
    
    <p>Dear <%= firstName %>,</p>
    
    <p>We regret to inform you that your scholarship application <strong>(<%= applicationId %>)</strong> for <strong><%= scholarshipTitle %></strong> has not been successful.</p>
    
    <div class="error-box">
      <h3 class="text-error">Interview Result</h3>
      <p style="margin: 8px 0;" class="text-error-light">
        <strong>Status:</strong> Interview did not meet requirements
      </p>
      <% if (failureReason) { %>
      <p style="margin: 8px 0;" class="text-error-light">
        <strong>Reason:</strong> <%= failureReason %>
      </p>
      <% } %>
    </div>
    
    <% if (adminNote) { %>
    <div class="note-box">
      <p style="margin: 0;" class="text-info">
        <strong>Note from Admin:</strong> <%= adminNote %>
      </p>
    </div>
    <% } %>
    
    <p>We appreciate your interest in our scholarship program and encourage you to apply again in the future when you meet the requirements.</p>
    
    <div class="button-container">
      <a href="<%= frontendUrl || 'http://localhost:5173' %>/student/profile" class="button">
        View Application Details
      </a>
    </div>
    
    <p>If you have any questions, please feel free to contact us.</p>
    
    <div class="footer">
      <p>Best regards,<br>The Nadoumi Team</p>
      <p>&copy; <%= new Date().getFullYear() %> Nadoumi. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
