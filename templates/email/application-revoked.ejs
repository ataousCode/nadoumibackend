<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Application Revoked - Action Required - Nadoumi</title>
  <style><%- include('../styles/email-base.css') %></style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">Nadoumi</div>
      <h1>⚠️ Action Required</h1>
    </div>

    <div class="warning-banner">
      <p style="margin: 0; font-size: 18px; font-weight: 600;" class="text-warning">
        Application Revoked
      </p>
      <p style="margin: 10px 0 0 0; font-size: 14px;" class="text-warning-light">
        Your application needs attention
      </p>
    </div>

    <p>Dear <%= firstName %>,</p>

    <p>
      We need to inform you that your scholarship application
      <strong>(<%= applicationId %>)</strong> for
      <strong><%= scholarshipTitle %></strong> has been
      <strong>revoked</strong> due to missing documents or incomplete
      information.
    </p>

    <div class="action-required-box">
      <h3 class="text-warning">⚠️ Action Required</h3>
      <p class="text-warning-light" style="font-weight: 600;">
        Please review the issues below and take the necessary actions to
        resubmit your application.
      </p>
    </div>

    <div class="details-box">
      <h3 class="text-warning">Reason for Revocation</h3>
      <p style="margin: 8px 0;" class="text-warning-light">
        <strong><%= revocationReason %></strong>
      </p>

      <% if (revocationDetails) { %>
      <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #fbbf24;">
        <h4 class="text-warning" style="font-size: 14px; margin-bottom: 8px;">
          Details:
        </h4>
        <p style="margin: 0; white-space: pre-line;" class="text-warning-light">
          <%= revocationDetails %>
        </p>
      </div>
      <% } %>
    </div>

    <% if (adminNote) { %>
    <div class="note-box">
      <p style="margin: 0;" class="text-info">
        <strong>Note from Admin:</strong> <%= adminNote %>
      </p>
    </div>
    <% } %>

    <div class="next-steps-box">
      <h3 class="text-warning">📋 Next Steps</h3>
      <ul class="text-warning-light">
        <li>Review the issues mentioned above</li>
        <li>Gather all required documents</li>
        <li>Update your application with complete information</li>
        <li>Resubmit your application once all issues are resolved</li>
      </ul>
    </div>

    <div class="button-container">
      <a href="<%= frontendUrl || 'http://localhost:5173' %>/student/profile" class="button">
        View Application & Fix Issues
      </a>
    </div>

    <p>
      Once you have addressed all the issues, your application will be
      reviewed again. We are here to help if you have any questions.
    </p>

    <div class="footer">
      <p>Best regards,<br>The Nadoumi Team</p>
      <p>&copy; <%= new Date().getFullYear() %> Nadoumi. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
