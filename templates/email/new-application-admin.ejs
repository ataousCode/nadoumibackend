<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Application Received - Nadoumi</title>
  <style><%- include('../styles/email-base.css') %></style>
</head>
<body>
  <div class="container">
    <div class="header-with-border">
      <h1>🎓 New Application Received</h1>
      <p style="color: #6b7280; margin: 10px 0 0 0;">A student has submitted a new scholarship application</p>
    </div>

    <div class="content">
      <p>Hello Admin,</p>
      <p>A new scholarship application has been submitted and requires your review.</p>

      <div class="info-section">
        <h3 style="color: #f97316;">Application Details</h3>
        <div class="info-row">
          <span class="info-label">Application ID:</span>
          <span class="info-value"><strong><%= applicationId %></strong></span>
        </div>
        <div class="info-row">
          <span class="info-label">Status:</span>
          <span class="info-value">
            Pending
            <span class="badge">NEW</span>
          </span>
        </div>
        <div class="info-row">
          <span class="info-label">Submitted At:</span>
          <span class="info-value"><%= submittedAt %></span>
        </div>
      </div>

      <div class="info-section">
        <h3 style="color: #f97316;">Student Information</h3>
        <div class="info-row">
          <span class="info-label">Name:</span>
          <span class="info-value"><strong><%= studentName %></strong></span>
        </div>
        <div class="info-row">
          <span class="info-label">Email:</span>
          <span class="info-value"><%= studentEmail %></span>
        </div>
        <% if (studentPhone) { %>
        <div class="info-row">
          <span class="info-label">Phone:</span>
          <span class="info-value"><%= studentPhone %></span>
        </div>
        <% } %>
        <% if (studentNationality) { %>
        <div class="info-row">
          <span class="info-label">Nationality:</span>
          <span class="info-value"><%= studentNationality %></span>
        </div>
        <% } %>
      </div>

      <div class="info-section">
        <h3 style="color: #f97316;">Scholarship Information</h3>
        <div class="info-row">
          <span class="info-label">Scholarship:</span>
          <span class="info-value"><strong><%= scholarshipTitle %></strong></span>
        </div>
        <% if (universityName) { %>
        <div class="info-row">
          <span class="info-label">University:</span>
          <span class="info-value"><%= universityName %></span>
        </div>
        <% } %>
      </div>

      <div class="button-container">
        <a href="<%= adminUrl %>" class="button">View Application in Admin Panel</a>
      </div>

      <p style="color: #6b7280; font-size: 14px; margin-top: 30px;">
        <strong>Next Steps:</strong><br>
        Please review the application in the admin panel and update its status accordingly.
      </p>
    </div>

    <div class="footer">
      <p>This is an automated notification from Nadoumi Application System.</p>
      <p>© <%= new Date().getFullYear() %> Nadoumi Consulting. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
