<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document Available - Nadoumi</title>
  <style><%- include('../styles/email-base.css') %></style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">Nadoumi</div>
      <h1>📄 Document Available</h1>
    </div>
    
    <div class="success-banner">
      <p style="margin: 0; font-size: 18px; font-weight: 600;" class="text-success">
        Great News, <%= firstName %>!
      </p>
      <p style="margin: 10px 0 0 0; font-size: 14px;" class="text-success-light">
        Your <%= documentType %> is now available
      </p>
    </div>
    
    <p>We are pleased to inform you that your <strong><%= documentType %></strong> for application <strong>(<%= applicationId %>)</strong> for <strong><%= scholarshipTitle %></strong> has been uploaded and is now available for download.</p>
    
    <div class="document-box">
      <h3 class="text-info">📋 Document Details</h3>
      <p style="margin: 8px 0;" class="text-info-light">
        <strong>Document Type:</strong> <%= documentType %>
      </p>
      <p style="margin: 8px 0;" class="text-info-light">
        <strong>Application ID:</strong> <%= applicationId %>
      </p>
      <p style="margin: 8px 0;" class="text-info-light">
        <strong>Scholarship:</strong> <%= scholarshipTitle %>
      </p>
    </div>
    
    <div class="next-steps-box">
      <h3 class="text-warning">📋 Next Steps</h3>
      <ul class="text-warning-light">
        <li>Log in to your student account</li>
        <li>Navigate to your application details</li>
        <li>Download the <%= documentType %></li>
        <li>Keep a copy for your records</li>
      </ul>
    </div>
    
    <div class="button-container">
      <a href="<%= frontendUrl || 'http://localhost:5173' %>/student/profile" class="button">
        View Application & Download Document
      </a>
    </div>
    
    <p>If you have any questions about the document, please contact us.</p>
    
    <div class="footer">
      <p>Best regards,<br>The Nadoumi Team</p>
      <p>&copy; <%= new Date().getFullYear() %> Nadoumi. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
