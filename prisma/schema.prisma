generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("PROD_DATABASE_URL")
}

model Admin {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String
  name           String         @default("Admin")
  phone          String?
  country        String?
  profilePicture String?
  role           String         @default("admin")
  lastLoginAt    DateTime?
  lastLoginIp    String?
  createdAt      DateTime       @default(now())
  auditLogs      AuditLog[]
  conversations  Conversation[]
  scholarships   Scholarship[]
  universities   University[]   @relation("UniversityCreatedBy")
}

model University {
  id                      String                  @id @default(uuid())
  universityId            String                  @unique
  name                    String
  nameInChinese           String?
  logo                    String?
  bannerImage             String?
  city                    String?
  province                String?
  type                    UniversityType          @default(Public)
  foundedYear             Int?
  totalStudents           Int?
  internationalStudents   Int?
  facultyCount            Int?
  numberOfPrograms        Int                     @default(0)
  introduction            String?
  description             String?
  history                 String?
  highlights              String[]
  opportunities           String[]
  partnershipCountries    String[]
  searchTags              String[]
  searchKeywords          String?
  scholarshipAvailability ScholarshipAvailability @default(Available)
  scholarshipNotes        Json?
  advantages              String[]
  accommodation           Json?
  campusFacilities        String[]
  nearbyInfo              String?
  officialWebsite         String?
  admissionsEmail         String?
  officePhone             String?
  albums                  Json?
  rankings                Json?
  isRecommended           Boolean                 @default(false)
  isPartner               Boolean                 @default(false)
  isTop                   Boolean                 @default(false)
  recommendationNotes     String?
  qsRank                  Int?
  requiredDocuments       Json?
  status                  UniversityStatus        @default(active)
  majors                  Json?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  adminId                 String?
  createdBy               Admin?                  @relation("UniversityCreatedBy", fields: [adminId], references: [id])
  scholarships            Scholarship[]           @relation("UniversityToScholarship")

  @@index([name])
  @@index([city])
  @@index([province])
  @@index([status])
  @@index([scholarshipAvailability])
}

model Scholarship {
  id                               String               @id @default(uuid())
  scholarshipId                    String               @unique
  title                            String
  titleInChinese                   String?
  universityJson                   Json?
  description                      String
  programCategories                ProgramCategory[]    @default([Bachelor])
  field                            String?
  programName                      String?
  degree                           String?
  duration                         Int?
  intake                           String?
  applicationDeadline              DateTime
  scholarshipCategory              ScholarshipCategory  @default(Partial)
  scholarshipDuration              Int?
  scholarshipDurationText          String?
  scholarshipPolicy                String?
  ageMin                           Int?
  ageMax                           Int?
  acceptedCountries                String[]
  chinaVisitPolicy                 String?
  acceptMinors                     Boolean?             @default(true)
  currentLocationPolicy            String?
  gpaMin                           Float?
  ieltsScore                       Float?
  toeflScore                       Int?
  duolingoScore                    Int?
  hskLevel                         Int?
  scoreRequirements                String?
  scoreRequirementsEnglish         String?
  scoreRequirementsChinese         String?
  originalTuitionFee               Float?
  tuitionFeeAfterScholarship       Float?
  accommodationFeeQuad             Float?
  accommodationFeeAfterScholarship Float?
  registrationFee                  String?
  universityFeeCurrency            Currency             @default(RMB)
  nadoumiApplicationFee            Float?
  nadoumiServiceFee                Float?
  nadoumiFeeCurrency               Currency             @default(USD)
  stipend                          Json?
  recommendationNotes              String?
  accommodationFee                 Json?
  applicantRequirements            Json?
  applicationDocuments             Json?
  additionalDocuments              Json?
  feeStructure                     Json?
  specialNotes                     String?
  requirements                     Json?
  benefits                         Json?
  startDate                        DateTime?
  availableSlots                   Int                  @default(1)
  status                           ScholarshipStatus    @default(draft)
  category                         String?
  isRecommended                    Boolean              @default(false)
  isHot                            Boolean              @default(false)
  isTop                            Boolean              @default(false)
  insurance                        String?
  teachingLanguage                 TeachingLanguage?    @default(English)
  additionalFees                   Json?
  coverImage                       String?
  tags                             String[]
  createdAt                        DateTime             @default(now())
  updatedAt                        DateTime             @updatedAt
  adminId                          String?
  applications                     Application[]
  createdBy                        Admin?               @relation(fields: [adminId], references: [id])
  programs                         ScholarshipProgram[]
  universities                     University[]         @relation("UniversityToScholarship")

  @@index([status])
  @@index([programCategories])
  @@index([scholarshipCategory])
}

model ScholarshipProgram {
  id               String                 @id @default(uuid())
  scholarshipId    String
  category         ProgramCategory
  programName      String?
  majors           String[]
  field            String?
  fields           String[]
  teachingLanguage TeachingLanguage       @default(English)
  duration         Int?
  intake           String?
  startDate        DateTime?
  stipendEnabled   Boolean                @default(false)
  stipendAmount    Float?
  stipendUnit      String?                @default("month")
  tuitionFee       Float?
  tuitionFeeAfter  Float?
  applicationFee   Float?
  serviceFee       Float?
  currency         Currency               @default(RMB)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  accommodations   ProgramAccommodation[]
  scholarship      Scholarship            @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@index([scholarshipId])
}

model ProgramAccommodation {
  id        String             @id @default(uuid())
  programId String
  roomType  String
  isFree    Boolean            @default(false)
  price     Float?
  currency  Currency           @default(RMB)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  program   ScholarshipProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

model Student {
  id                          String         @id @default(uuid())
  email                       String         @unique
  password                    String
  firstName                   String
  lastName                    String
  country                     String
  passportNumber              String         @unique
  phone                       String?
  profilePicture              String?
  dateOfBirth                 DateTime?
  nationality                 String?
  city                        String?
  gender                      Gender?        @default(Male)
  isEmailVerified             Boolean        @default(false)
  emailVerificationOTP        String?
  emailVerificationOTPExpires DateTime?
  passwordResetToken          String?
  passwordResetExpires        DateTime?
  profile                     Json?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  applications                Application[]
  conversations               Conversation[]

  @@index([email])
  @@index([nationality])
  @@index([country])
}

model Application {
  id                String            @id @default(uuid())
  applicationId     String            @unique
  studentId         String
  scholarshipId     String
  legacyId          String?           @map("legacy_id")
  applicant         Json?
  fields            Json?
  personalInfo      Json?
  contactInfo       Json?
  familyInfo        Json?
  preferences       Json?
  documents         Json?
  status            ApplicationStatus @default(pending)
  statusHistory     Json?
  submittedAt       DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  interviewDetails  Json?
  rejectionDetails  Json?
  acceptedAt        DateTime?
  admissionDocument Json?
  jw202Document     Json?
  scholarship       Scholarship       @relation(fields: [scholarshipId], references: [id])
  student           Student           @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([scholarshipId])
  @@index([status])
}

model Notification {
  id        String             @id @default(uuid())
  type      NotificationType   @default(email)
  template  String
  recipient String
  subject   String?
  content   Json
  status    NotificationStatus @default(pending)
  error     String?
  sentAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([recipient])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  resource   String
  resourceId String
  adminId    String
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  admin      Admin    @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([resource, resourceId])
}

model Conversation {
  id                 String    @id @default(uuid())
  studentId          String
  adminId            String?
  lastMessage        String?
  lastMessageAt      DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  unreadCountAdmin   Int       @default(0)
  unreadCountStudent Int       @default(0)
  admin              Admin?    @relation(fields: [adminId], references: [id])
  student            Student   @relation(fields: [studentId], references: [id])
  messages           Message[]

  @@index([studentId])
  @@index([adminId])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  senderRole     String
  content        String
  type           MessageType   @default(text)
  fileUrl        String?
  fileName       String?
  fileSize       String?
  status         MessageStatus @default(sent)
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

enum ScholarshipAvailability {
  Available
  Limited
  Not_Available @map("Not Available")
}

enum UniversityType {
  Public
  Private
}

enum UniversityStatus {
  active
  inactive
  draft
}

enum Currency {
  RMB
  USD
}

enum ProgramCategory {
  Language
  Bachelor
  Master
  PhD
}

enum ScholarshipCategory {
  Self_funded  @map("Self-funded")
  Partial
  CSC
  Province
  Universities
  HSK
  Type_A       @map("Type A")
  Type_B       @map("Type B")
  Type_C       @map("Type C")
  Other
}

enum ScholarshipStatus {
  draft
  published
  closed
  active
  inactive
  limited
}

enum Gender {
  Male
  Female
  Other
}

enum ApplicationStatus {
  pending
  received
  under_review
  interview
  interview_passed
  interview_failed
  accepted
  rejected
  revoked
  waitlisted
}

enum NotificationType {
  email
  sms
  push
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum MessageType {
  text
  file
  image
}

enum MessageStatus {
  sent
  delivered
  read
}

enum TeachingLanguage {
  English
  Chinese
  Both
}
